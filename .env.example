# Variables consumed by docker-compose.yml for Compose-level variable
# substitution (Postgres/Redis container config, and the DATABASE_URL /
# REDIS_PASSWORD injected into the backend and worker services at runtime).
# This is separate from backend/.env.example, which configures the backend
# application process itself.

# POSTGRES_USER and POSTGRES_DB default to "postgres" and "teamos" if unset
# (see docker-compose.yml), so they're optional for local development.
POSTGRES_USER=postgres
POSTGRES_DB=teamos

# Required - Compose fails fast if this is unset. Local-development-only
# example value - change it to anything you like, it only needs to match
# whatever DATABASE_URL you configure in backend/.env if you also run the
# backend directly on the host (see backend/.env.example).
POSTGRES_PASSWORD=postgres

# Required - Compose fails fast if this is unset. Used both to start the
# Redis container (--requirepass) and as the single source of truth for the
# REDIS_PASSWORD injected into the backend and worker containers.
# Local-development-only example value - see the POSTGRES_PASSWORD comment
# above.
REDIS_PASSWORD=redis
