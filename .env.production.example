# Production Compose interpolation values for docker-compose.prod.yml - see
# docs/development/deployment.md. Copy to .env.production ON THE PRODUCTION
# HOST ONLY (chmod 600); never commit the real file.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production <cmd>

# The single public HTTPS origin, no trailing slash. Used as Caddy's site
# address, baked into the frontend build (VITE_API_URL), and passed to the
# backend as BETTER_AUTH_URL, FRONTEND_URL, and TRUSTED_ORIGINS.
PUBLIC_ORIGIN=https://<dns-label>.centralindia.cloudapp.azure.com

POSTGRES_USER=teamos
POSTGRES_DB=teamos

# Generate each with: openssl rand -hex 32
# (hex avoids characters that need escaping in Compose env files.)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
