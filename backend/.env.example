DATABASE_URL=

BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Resend API key used to send transactional email (e.g. invitations).
RESEND_API_KEY=

# Verified sender address configured in Resend.
EMAIL_FROM=

# Base URL of the frontend app, used to build links in transactional email
# (e.g. invitation accept links).
FRONTEND_URL=

# Comma-separated list of origins allowed to call the API (CORS), Better
# Auth, and Socket.IO. Required in production; falls back to localhost
# defaults in development if unset.
#
# The backend/Dockerfile image always sets NODE_ENV=production, so this is
# required any time the backend runs via `docker compose up`, including
# local development - not only in a real deployment. Example for a local
# frontend running on the Vite default port:
#   TRUSTED_ORIGINS=http://localhost:5173
TRUSTED_ORIGINS=

# Number of reverse-proxy hops between the client and this server (used for
# Express's "trust proxy" setting, e.g. correct client IP behind a load
# balancer). Required in production (like TRUSTED_ORIGINS above) - and, per
# that same comment, the backend/Dockerfile image always sets
# NODE_ENV=production, so this is required any time the backend runs via
# `docker compose up`, including local development. Set to 0 if there is no
# reverse proxy in front of the API (true for this project's default local
# Docker Compose setup, which runs the backend directly on the exposed
# port). Falls back to 0 automatically outside production if left unset.
TRUST_PROXY_HOPS=

# NODE_ENV=production gates production-only checks (e.g. TRUSTED_ORIGINS
# becoming required). Not otherwise listed here - typically set by the
# hosting platform rather than a .env file.