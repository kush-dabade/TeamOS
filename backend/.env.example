# Only consulted when running the backend directly on the host (e.g.
# `npm run dev`, outside Docker) against the Postgres container's port
# exposed on localhost:5432 by docker-compose.yml - the password must match
# POSTGRES_PASSWORD in the root .env. `docker compose up` ignores this
# entirely for the backend/worker/migrate services; they always build their
# own connection from the POSTGRES_* values below instead (see
# docker-compose.yml and src/config/database.config.ts).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teamos

# Base URL Better Auth issues links against and validates its own origin
# with - read implicitly by the Better Auth SDK via this exact env var name,
# not read directly anywhere in src/.
BETTER_AUTH_URL=http://localhost:3000

# Signing secret for session tokens, and in this codebase also reused as the
# HMAC key for password-reset/verification job IDs and rate-limit keys (see
# lib/auth.ts). This is a real cryptographic secret, not local-infra
# plumbing like the Postgres/Redis passwords below - do not commit a real
# value, and don't reuse this example verbatim across projects. Generate
# your own, e.g.:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Only consulted as a fallback when DATABASE_URL above is unset, and even
# then only usable from inside a container on the Docker network -
# database.config.ts resolves the Postgres host to the internal hostname
# "postgres", which does not resolve from the host machine. `docker compose
# up` doesn't use these either (see the DATABASE_URL comment above). Left
# blank; set DATABASE_URL instead if you need a host-side connection string.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Only consulted when running the backend directly on the host, for the same
# reason as DATABASE_URL above - `docker compose up` always injects its own
# REDIS_HOST/REDIS_PORT/REDIS_PASSWORD for the backend/worker containers
# (see docker-compose.yml). The password must match REDIS_PASSWORD in the
# root .env.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

# Resend API key used to send transactional email (e.g. invitations,
# verification, password reset). Safe to leave blank for local development -
# the worker starts normally either way; without a value it just skips
# actually sending mail (see modules/email/email.config.ts /
# modules/email/email.service.ts) instead of calling a real Resend account.
# Required in every other environment (production, and this repo's own test
# suite - see backend/.env.test.example).
RESEND_API_KEY=

# Verified sender address configured in Resend. Same status as
# RESEND_API_KEY above.
EMAIL_FROM=

# Base URL of the frontend app, used to build links in transactional email
# (e.g. invitation accept links) and as Better Auth's default
# email-verification callback target.
FRONTEND_URL=http://localhost:5173

# Comma-separated list of origins allowed to call the API (CORS), Better
# Auth, and Socket.IO. Required in production; falls back to
# http://localhost:3000 and http://localhost:5173 automatically outside
# production (see config/security.config.ts) - which already matches this
# project's default local setup. The value below is set explicitly anyway
# (rather than relying on that fallback) so this file stays correct even if
# NODE_ENV is ever set to production locally (e.g. to exercise production
# config on purpose). Example for a local frontend running on the Vite
# default port, alongside the backend's own origin:
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Number of reverse-proxy hops between the client and this server (used for
# Express's "trust proxy" setting, e.g. correct client IP behind a load
# balancer). Required in production (like TRUSTED_ORIGINS above); 0 is
# correct here because this project's default local Docker Compose setup
# has no reverse proxy in front of the API - it's exposed directly on the
# mapped port.
TRUST_PROXY_HOPS=0

# NODE_ENV is not set here - docker-compose.yml sets it directly for the
# backend/worker services (development, for local use; see its comment for
# why). The backend/Dockerfile image itself still defaults to production,
# which is the correct default for wherever this image eventually runs
# outside this Compose file. Not meant to be set via this file.