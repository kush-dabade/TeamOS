DATABASE_URL=

BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Resend API key used to send transactional email (e.g. invitations).
RESEND_API_KEY=

# Verified sender address configured in Resend.
EMAIL_FROM=

# Base URL of the frontend app, used to build links in transactional email
# (e.g. invitation accept links).
FRONTEND_URL=

# Comma-separated list of origins allowed to call the API (CORS), Better
# Auth, and Socket.IO. Required in production; falls back to localhost
# defaults in development if unset.
TRUSTED_ORIGINS=

# Number of reverse-proxy hops between the client and this server (used for
# Express's "trust proxy" setting, e.g. correct client IP behind a load
# balancer). Defaults to 0 (no proxy trusted) if unset.
TRUST_PROXY_HOPS=

# NODE_ENV=production gates production-only checks (e.g. TRUSTED_ORIGINS
# becoming required). Not otherwise listed here - typically set by the
# hosting platform rather than a .env file.