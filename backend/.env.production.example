# Production application secrets for the backend and worker containers
# (env_file in docker-compose.prod.yml) - see docs/development/deployment.md.
# Copy to backend/.env.production ON THE PRODUCTION HOST ONLY (chmod 600);
# never commit the real file.
#
# Deliberately NOT set here, because docker-compose.prod.yml sets them:
# NODE_ENV, BETTER_AUTH_URL, FRONTEND_URL, TRUSTED_ORIGINS, TRUST_PROXY_HOPS
# (derived from PUBLIC_ORIGIN / the fixed proxy topology), and DATABASE_URL,
# POSTGRES_*, REDIS_* (from the root .env.production).

# Session-signing secret, also the HMAC key for job IDs and rate-limit keys
# (see src/lib/auth.ts). Unique to production - never reuse a development
# value. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required in production - the worker refuses to start without both (see
# src/modules/email/email.config.ts). Without a verified sending domain,
# Resend's onboarding@resend.dev sender only delivers to the Resend account
# owner's own address. Once a domain is verified, use a sender on it, e.g.
# EMAIL_FROM="TeamOS <no-reply@mail.example.com>" (docs/development/deployment.md#email).
RESEND_API_KEY=
EMAIL_FROM=
