# Copy this file to backend/.env.test and adjust values. tests/global-setup.ts
# runs Prisma migrations and tests/setup/reset-database.ts TRUNCATEs against
# DATABASE_URL below - it must point at a disposable database, never the
# same one your real backend/.env uses.
#
# One-time setup: create a second database inside the same Postgres
# instance docker-compose already runs for development, e.g.:
#   docker compose exec postgres createdb -U postgres teamos_test
DATABASE_URL="postgresql://postgres:<same password as .env>@localhost:5432/teamos_test"

BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="test-secret-do-not-use-in-production"

TRUSTED_ORIGINS="http://localhost:3000"
TRUST_PROXY_HOPS=0

FRONTEND_URL="http://localhost:5173"

# Tests don't run a worker themselves, but they do create real BullMQ jobs
# (e.g. every sign-up enqueues a verification email job) and write real
# rate-limit counters - on the SAME Redis instance docker-compose already
# runs for development, since REDIS_HOST/PORT/PASSWORD below are unchanged.
# Without REDIS_DB below, those test-created jobs would be visible to - and
# consumable by - a real `npm run worker` / `docker compose up worker`
# process running against backend/.env, which would process them for real
# (a real Resend call, for email jobs). REDIS_DB puts tests on a separate
# logical Redis database so a dev/prod worker never sees what tests enqueue,
# without needing a second Redis container.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<same password as .env>
REDIS_DB=1
